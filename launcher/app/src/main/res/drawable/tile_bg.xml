<?xml version="1.0" encoding="utf-8"?>
<!-- PennyOS: misty glass behind an icon tile (the mockups' rgba(229,238,248,.09) card with a faint light edge),
     so the wallpaper shows through instead of a flat grey card. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="270" android:startColor="#2EE5EEF8" android:endColor="#14E5EEF8" />
    <stroke android:width="1dp" android:color="#29E5EEF8" />
    <corners android:radius="16dp" />
</shape>

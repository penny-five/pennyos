<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F5FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <!-- Reorder button while reorder mode is on (focus is on the tiles then): lamp yellow. -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="#2EF8DE79" />
            <stroke android:width="1.5dp" android:color="@color/penny_lamp" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <!-- Dark-water glass, so the white label reads over a bright wallpaper too. -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#9E22437B" android:endColor="#8C14102E" />
            <stroke android:width="1dp" android:color="#42E5EEF8" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>

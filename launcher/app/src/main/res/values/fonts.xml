<?xml version="1.0" encoding="utf-8"?>
<!-- The UI fonts, looked up through these strings so a locale can swap in a system family. PennyOS bundles
     Montserrat (the typeface of Tampere's brand), cut to the Latin letters the launcher shipped with Outfit and
     to weights 200-600; values-vi still points at the system sans-serif for the Vietnamese accents (#833). -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="ReferenceType">
    <string name="font_body" translatable="false">@font/montserrat</string>
    <string name="font_regular" translatable="false">@font/montserrat_regular</string>
    <string name="font_light" translatable="false">@font/montserrat_light</string>
    <string name="font_extralight" translatable="false">@font/montserrat_extralight</string>
    <string name="font_medium" translatable="false">@font/montserrat_medium</string>
</resources>
